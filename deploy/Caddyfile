# Cloudflare sta davanti. Qui dentro ci sono due cose:
#   - la 80, che serve tutto e funziona da sempre;
#   - i siti in TLS sulla 443, che vivono in file a parte e compaiono solo
#     quando sul VPS ci sono i loro certificati.
#
# QUESTA DIVISIONE NON E' ESTETICA. Un blocco `tls` che punta a un file
# inesistente impedisce a Caddy di partire, e Caddy che non parte vuol dire
# sito giu'. Mettendo quel blocco in /etc/busroma/siti, che il webhook non
# tocca perche' sta fuori dal repository, il deploy resta sicuro in ogni
# momento: se i certificati non ci sono, il file non c'e', e la glob vuota
# per Caddy non e' un errore ("an empty glob pattern is not an error").
{
	# Niente certificati automatici. Caddy saprebbe prenderseli da Let's
	# Encrypt, ma non qui: l'NSG di Azure lascia entrare solo gli indirizzi
	# di Cloudflare, quindi la validazione HTTP-01 non arriverebbe mai
	# all'origine. Si usano i certificati Origin CA di Cloudflare, che valgono
	# solo fra Cloudflare e noi e durano quindici anni.
	auto_https off
}

# Il pezzo comune: l'app, e il webhook di deploy che gira sull'host.
(comune) {
	handle /hooks/* {
		reverse_proxy host.docker.internal:9000
	}
	reverse_proxy app:3000
}

# La 80, come e' sempre stata. bus.disagio.dev passa di qui e non si muove.
:80 {
	import comune
}

# I siti in TLS, se ci sono. Vedi OPERATIONS.md §7 per come aggiungerne uno.
import /etc/caddy/siti/*.caddy
