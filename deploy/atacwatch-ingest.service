[Unit]
Description=AtacWatch — ETL GTFS statico
Documentation=https://github.com/paolo-pulli/AtacWatch
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/atacwatch
# Esegue l'ingest in un container usa-e-getta; usa la stessa immagine del worker.
ExecStart=docker compose run --rm worker pnpm ingest:static
StandardOutput=journal
StandardError=journal
# Timeout generoso: il download del GTFS + rebuild Postgres può durare qualche minuto.
TimeoutStartSec=600
