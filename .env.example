# ============================================================
# AtacWatch — variabili d'ambiente per il deploy su VPS
# Copia questo file in .env e compila i valori reali.
# .env NON va mai committato nel repository.
# ============================================================

# Password del database PostgreSQL (usata internamente da Docker).
# Scegli una stringa lunga e casuale: openssl rand -base64 32
DB_PASSWORD=cambia_questa_password

# Dominio non necessario: TLS e routing DNS sono gestiti da Cloudflare.
